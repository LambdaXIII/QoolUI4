# clangd 配置
#
# CompilationDatabase：指向 CMake 生成的编译数据库（dev-msvc-debug preset，
# CMAKE_EXPORT_COMPILE_COMMANDS=ON）。compile_commands.json 在
# build/build-msvc-Debug/，不在 clangd 默认搜索的 build/ 位置，需显式指定。
# 该数据库含 MSVC 原生命令（-external:I 等），clangd 的 clang 前端按
# clang-cl 模式解析（见 clangd 文档：MSVC 编译数据库原生支持）。
CompileFlags:
  CompilationDatabase: build/build-msvc-Debug

  # Qt 6 在 Linux/GCC 下注入 -mno-direct-extern-access
  # （QT_FEATURE_no_direct_extern_access；Clang 编译时 Qt 注入等价的
  # -fno-direct-access-external-data）。clangd 的 clang 不识别 GCC 专属
  # 参数，报 drv_unknown_argument——移除。该参数仅影响代码生成的符号
  # 寻址方式，与语义分析无关，移除无损。
  Remove:
    - -mno-direct-extern-access

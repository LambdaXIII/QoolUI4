<?xml version="1.0" encoding="UTF-8"?>
<qooltheme name="catppuccin">
    <author>qoolui</author>
    <description>A Qool Catppuccin Mocha theme</description>
    <constants>

        <stringlist property="papaWords">
            <string>Pa !</string>
            <string>啪！</string>
            <string>啪!!!</string>
            <string>啪啪!</string>
            <string>啪啪啪</string>
        </stringlist>

        <number property="instantDuration" value="100"/>
        <number property="transitionDuration" value="200"/>
        <number property="movementDuration" value="400"/>

        <number property="menuCutSize" copy="buttonCutSize"/>
        <number property="buttonCutSize" value="5"/>

        <number property="textSize" value="16" />
        <number property="titleTextSize" copy="textSize" add="4"/>
        <number property="toolTipTextSize" copy="textSize" add="-6"/>
        <number property="importantTextSize" copy="textSize" multiply="2"/>
        <number property="decorativeTextSize" copy="toolTipTextSize"/>

        <number property="controlCutSize" value="10"/>
        <number property="controlBorderWidth" value="1"/>
        <number property="controlTitleTextSize" copy="controlTextSize" add="-4" />
        <number property="controlTextSize" copy="textSize" add="-2"/>

        <number property="windowCutSize" value="35"/>
        <number property="windowElementSpacing" value="5"/>
        <number property="windowEdgeSpacing" value="5"/>
        <number property="windowTitleTextSize" value="14"/>
        <number property="windowBorderWidth" value="1"/>

        <number property="dialogCutSize" copy="controlCutSize"/>
        <number property="dialogBorderWidth" copy="controlBorderWidth"/>

        <!-- Default Colors (Catppuccin Mocha) -->
        <color property="white" value="#CDD6F4"/>
        <color property="silver" value="#A6ADC8"/>
        <color property="grey" value="#313244"/>
        <color property="black" value="#1E1E2E"/>
        <color property="red" value="#F38BA8"/>
        <color property="maroon" value="#EBA0AC"/>
        <color property="yellow" value="#F9E2AF"/>
        <color property="olive" value="#A6E3A1"/>
        <color property="lime" value="#A6E3A1"/>
        <color property="green" value="#A6E3A1"/>

        <color property="aqua" value="#94E2D5"/>
        <color property="cyan" value="#89DCEB"/>
        <color property="teal" value="#94E2D5"/>
        <color property="blue" value="#89B4FA"/>
        <color property="navy" value="#74C7EC"/>
        <color property="fuchsia" value="#F5C2E7"/>
        <color property="purple" value="#CBA6F7"/>
        <color property="orange" value="#FAB387"/>
        <color property="brown" value="#EBA0AC"/>
        <color property="pink" value="#F5C2E7"/>

        <!-- Main Styles -->
        <color property="positive" copy="green"/>
        <color property="negative" copy="red"/>
        <color property="warning" copy="pink"/>

        <color property="controlBackgroundColor" copy="grey"/>
        <color property="controlBorderColor" value="#585B70"/>
        <color property="infoColor" copy="cyan"/>
    </constants>
    <active>
        <!--Active group is a must-have-->
        <!--Tone Colors-->
        <color property="accent" copy="purple"/>
        <!-- BG Colors-->
        <color property="light" value="#CDD6F4"/>
        <color property="midlight" copy="light" darker="1.2"/>
        <color property="dark" value="#1E1E2E"/>
        <color property="mid" copy="dark" darker="1.2"/>
        <color property="shadow" copy="dark" darker="1.5"/>
        <!-- Highlights-->
        <color property="highlight" copy="accent" lighter="1.2" />
        <color property="highlightedText" copy="dark" />
        <color property="link" value="#89DCEB"/>
        <color property="linkVisited" value="#B4BEFE" />
        <!--UI Control Colors-->
        <color property="text" value= "#CDD6F4"/>
        <color property="base" value="#313244"/>
        <color property="alternateBase" copy="base" lighter="1.1"/>
        <color property="window" copy="dark" />
        <color property="windowText" copy="text"/>
        <color property="button" copy="base"/>
        <color property="buttonText" copy="text"/>
        <color property="placeholderText" copy="text" darker="1.5"/>
        <color property="toolTipBase" value= "#45475A"/>
        <color property="toolTipText" copy="text"/>
    </active>
    <inactive>
        <!--Can contain different vlues only-->
        <color property="accent" copy="buttonText"/>
    </inactive>
    <disabled>
        <!--Can contain different vlues only-->
        <color property="accent" copy="negative"/>
        <color property="text" copy="text" darker="1.8"/>
        <color property="windowText" copy="text" darker="1.8"/>
        <color property="buttonText" copy="text" darker="1.8"/>
        <color property="controlBorderColor" copy="negative"/>
    </disabled>
</qooltheme>

/*!
    \page qoolui-property-macros.html
    \inmodule QoolCommon
    \title 属性宏体系（QoolCommon）
    \brief QML/Qt 属性声明的宏族：QOBJECT / QBINDABLE / QGADGET 三族 + QOOL_FOREACH_N 批量生成。

    本页记述 QoolCommon 属性宏体系的定位、签名、用法与陷阱。
    属性宏体系禁止手写 Q_PROPERTY + getter/setter 样板，按场景选宏族。

    \section1 宏族定位

    \list
      \li \c QOBJECT_*——QObject 类属性：一条宏 = 信号 + getter + setter +
          成员 + Q_PROPERTY（NOTIFY 语义，setter 显式相等守卫）。
      \li \c QBINDABLE_*——QObject bindable 属性：成员为
          \c Q_OBJECT_BINDABLE_PROPERTY，值变化经 bindable 通知（setter
          不写守卫是刻意的——\c operator= 内置相等守卫），并生成
          \c bindable_xxx()（\c QBindable{&member}）供 Q_PROPERTY 的
          \c BINDABLE 关键字（QML 引擎走 bindable 接口而非信号）。
      \li \c QGADGET_*——Q_GADGET 值类型属性：getter + setter + 成员 +
          Q_PROPERTY 注册，无 NOTIFY（值类型无信号能力）。
    \endlist

    \section1 签名与参数

    三族均有 \c DECLARE 后缀版（仅声明信号/getter/setter/Q_PROPERTY，
    不生成成员——成员与实现归类/类外手写，适用于派生计算属性等场景）。

    \list
      \li \c QOBJECT_*_PROPERTY(\e{T}, \e{N}, \e{D}, ...)——\e{D} 默认值必填
      \li \c QBINDABLE_*_PROPERTY(\e{C}, \e{T}, \e{N}, ...)——\b{无默认值参数}
      \li \c QGADGET_*_PROPERTY(\e{T}, \e{N}, \e{D}, ...)——\e{D} 默认值必填
      \li \c DECLARE 版一律 (\e{T}, \e{N}, ...)——无默认值参数
    \endlist

    \b{陷阱}：\c ... 是 Q_PROPERTY 附加选项通道（CONSTANT/FINAL 等）。
    DECLARE 版与 QBINDABLE 族误传默认值（如
    \c{QOBJECT_WRITABLE_PROPERTY_DECLARE(int, x, 0)}）时，\c 0 静默进入
    Q_PROPERTY 尾部，moc 报晦涩 Parse error（错误指向宏定义处而非调用处）。

    \section1 批量属性生成

    同型属性清单（如 20 个 QColor）用 \l{QOOL_FOREACH_N}{QOOL_FOREACH_N}
    体系批量生成：对每个属性名展开局部宏 \c __HANDLE__，用完 \c #undef。

    \code
    #define __HANDLE__(N) QOBJECT_WRITABLE_PROPERTY(QColor, N, Qt::transparent)
    QOOL_FOREACH_10(__HANDLE__, white, silver, grey, black, red, green, blue, cyan, magenta, yellow)
    #undef __HANDLE__
    \endcode

    同一属性清单跨类复用（\c Style / \c StyleGroupAgent 各持一份）时，
    .cpp 用相同 FOREACH 结构生成 emit 保持同步。

    \section1 参数类型约定

    setter 参数类型自动选择：指针按值传 \c T*，其余传 \c const T&。
    宏固定命名：成员 \c m_xxx、setter 参数 \c new_xxx、getter 无前缀
    \c xxx()、bindable \c bindable_xxx()。

    \section1 批量属性变更

    多属性原子变更用 \c Qt::beginPropertyUpdateGroup() /
    \c endPropertyUpdateGroup() 包裹，多次 emit 原子化。
*/

/*!
    \macro QOBJECT_WRITABLE_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief QObject 可写属性：NOTIFY 信号 + 相等守卫 setter。

    生成 \c N##Changed() 信号、\c N() getter、\c set_N() setter（相等
    守卫 + emit）、成员 \c m_N{D}、Q_PROPERTY（WRITE + NOTIFY）。

    \code
    class Demo : public QObject {
        Q_OBJECT
        QOBJECT_WRITABLE_PROPERTY(int, value, 0)
    };
    \endcode
*/

/*!
    \macro QOBJECT_READONLY_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief QObject 只读属性：NOTIFY 信号 + getter（无 setter）。

    setter 由类内实现（protected 成员可直接写 \c m_N）。
*/

/*!
    \macro QOBJECT_CONSTANT_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief QObject 常量属性：getter + Q_PROPERTY(CONSTANT)，无信号。

    值在构造后不变（引擎按常量处理，不监听变化）。
*/

/*!
    \macro QOBJECT_WRITABLE_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 可写属性声明版：不生成成员与实现。

    大文件声明/定义分离用——头文件仅声明，.cpp 用同宏实现或手写
    setter（含相等守卫 + emit）。默认值由实现处成员初始化给定。
*/

/*!
    \macro QOBJECT_READONLY_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 只读属性声明版：不生成成员与实现。
*/

/*!
    \macro QOBJECT_CONSTANT_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 常量属性声明版：不生成成员与实现。
*/

/*!
    \macro QBINDABLE_WRITABLE_PROPERTY(C, T, N, ...)
    \inmodule QoolCommon
    \brief QObject bindable 可写属性：Q_OBJECT_BINDABLE_PROPERTY 成员 + BINDABLE。

    生成 \c N##Changed() 信号、getter、setter（赋值成员，相等守卫由
    \c operator= 内置——不写守卫是刻意的，勿补勿删）、\c bindable_N()
    （\c QBindable{&m_N}）、Q_PROPERTY（WRITE + NOTIFY + BINDABLE）。

    \code
    class Demo : public QObject {
        Q_OBJECT
        QBINDABLE_WRITABLE_PROPERTY(Demo, int, value)
    public:
        QBindable<int> bindableValue() const; // 宏生成（非 const 版本）
    };
    \endcode

    QML 引擎对 BINDABLE 属性用 bindable 接口做绑定与变更追踪，不依赖
    信号。\c setValue() 移除绑定、\c setBinding() 立即求值一次——
    见 Qt 的 QProperty/QBindable 文档。
*/

/*!
    \macro QBINDABLE_READONLY_PROPERTY(C, T, N, ...)
    \inmodule QoolCommon
    \brief QObject bindable 只读属性：bindable 成员 + BINDABLE，无 setter。

    setter 经 \c QBINDABLE_SET_VALUE / \c QBINDABLE_SET_BINDING 或直接
    写成员（protected 可见）。
*/

/*!
    \macro QBINDABLE_WRITABLE_PROPERTY_DECLARE(C, T, N, ...)
    \inmodule QoolCommon
    \brief bindable 可写属性声明版：不生成成员与实现（声明分离用）。
*/

/*!
    \macro QBINDABLE_READONLY_PROPERTY_DECLARE(C, T, N, ...)
    \inmodule QoolCommon
    \brief bindable 只读属性声明版：不生成成员与实现。
*/

/*!
    \macro QOOL_BINDABLE_MEMBER(C, T, N)
    \inmodule QoolCommon
    \brief bindable 成员声明原语：信号 + Q_OBJECT_BINDABLE_PROPERTY 成员。

    宏族内部组合件，通常不单独使用。
*/

/*!
    \macro QOOL_MAKE_PROPERTY_BINDABLE(T, N)
    \inmodule QoolCommon
    \brief 给非宏体系的普通 Q_PROPERTY 补 bindable 访问。

    生成 \c bindable_N()（\c QBindable{this, "N"} 形态——包装属性名，
    属性须有 notify 信号）。用于绑定表达式读取（须经
    \c QBindable::value() 建立依赖追踪）；\b{不可用于实现 BINDABLE}——
    \c QBindable{obj, name} 构造不支持依赖追踪（Qt 文档明示）。
*/

/*!
    \macro QBINDABLE_SET_VALUE(N, V)
    \inmodule QoolCommon
    \brief bindable 成员赋值：\c{m_N.setValue(V)}（移除绑定）。
*/

/*!
    \macro QBINDABLE_SET_BINDING(N, V)
    \inmodule QoolCommon
    \brief bindable 成员绑定：\c{m_N.setBinding(V)}（立即求值一次）。
*/

/*!
    \macro QGADGET_WRITABLE_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief Q_GADGET 值类型可写属性：getter + setter + 成员 + Q_PROPERTY。

    无 NOTIFY（值类型无信号能力）。setter 无相等守卫（值类型通常整值
    替换）；需要守卫的场景手写 setter。

    \code
    struct Demo {
        Q_GADGET
    public:
        QGADGET_WRITABLE_PROPERTY(int, value, 0)
    };
    \endcode
*/

/*!
    \macro QGADGET_READONLY_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief 值类型只读属性：getter + 成员 + Q_PROPERTY。
*/

/*!
    \macro QGADGET_CONSTANT_PROPERTY(T, N, D, ...)
    \inmodule QoolCommon
    \brief 值类型常量属性：getter + Q_PROPERTY(CONSTANT)。
*/

/*!
    \macro QGADGET_WRITABLE_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 值类型可写属性声明版：不生成成员与实现。
*/

/*!
    \macro QGADGET_READONLY_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 值类型只读属性声明版。
*/

/*!
    \macro QGADGET_CONSTANT_PROPERTY_DECLARE(T, N, ...)
    \inmodule QoolCommon
    \brief 值类型常量属性声明版。
*/

/*!
    \macro QOOL_FOREACH_N
    \inmodule QoolCommon
    \brief 同型属性清单批量生成（N 上限版，行为确定）。

    \c QOOL_FOREACH_2 至 \c QOOL_FOREACH_10：对每个元素展开 \c _M(a)。
    与已弃用的 \c QOOL_MACRO_FOREACH（变参递归版，不可用/未完成/过度
    复杂，见 macro_foreach_x.hpp）区别：本体系 N 显式上限、无递归、
    展开行为确定。

    \code
    #define __HANDLE__(N) QOBJECT_WRITABLE_PROPERTY(QColor, N, Qt::black)
    QOOL_FOREACH_10(__HANDLE__, white, silver, grey, black, red, green, blue, cyan, magenta, yellow)
    #undef __HANDLE__
    \endcode
*/
